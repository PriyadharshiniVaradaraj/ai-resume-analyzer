/* =====================================================
   AI RESUME ANALYZER
   PREMIUM WEBSITE DESIGN
===================================================== */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    background: #f8fafc;
    color: #111827;
    line-height: 1.6;
}

/* =====================================================
   NAVBAR
===================================================== */

.navbar {
    position: sticky;
    top: 0;
    z-index: 1000;

    background: rgba(255,255,255,0.90);

    backdrop-filter: blur(15px);

    border-bottom: 1px solid #e5e7eb;
}

.nav-container {
    max-width: 1200px;
    margin: auto;

    height: 72px;

    padding: 0 25px;

    display: flex;
    align-items: center;
    justify-content: space-between;
}

.logo {
    font-size: 22px;
    font-weight: 800;

    color: #4f46e5;
}

.logo span {
    color: #111827;
}

.nav-links {
    display: flex;

    list-style: none;

    gap: 32px;
}

.nav-links a {
    text-decoration: none;

    color: #475569;

    font-size: 15px;

    font-weight: 500;

    transition: 0.3s;
}

.nav-links a:hover {
    color: #4f46e5;
}

.nav-button {
    padding: 10px 20px;

    background: #4f46e5;

    color: white !important;

    border-radius: 8px;
}

/* =====================================================
   HERO
===================================================== */

.hero {
    position: relative;

    overflow: hidden;

    min-height: 650px;

    padding: 90px 20px;

    background:
        radial-gradient(
            circle at 10% 20%,
            rgba(99,102,241,0.20),
            transparent 30%
        ),
        radial-gradient(
            circle at 90% 30%,
            rgba(168,85,247,0.20),
            transparent 30%
        ),
        linear-gradient(
            135deg,
            #eef2ff,
            #faf5ff,
            #f8fafc
        );
}

.hero-container {
    max-width: 1200px;

    margin: auto;

    display: grid;

    grid-template-columns: 1.1fr 0.9fr;

    gap: 70px;

    align-items: center;
}

.hero-content {
    max-width: 650px;
}

.badge {
    display: inline-block;

    padding: 8px 15px;

    background: white;

    border: 1px solid #ddd6fe;

    color: #5b21b6;

    border-radius: 30px;

    font-size: 13px;

    font-weight: 600;

    margin-bottom: 22px;

    box-shadow: 0 5px 20px rgba(0,0,0,0.05);
}

.hero h1 {
    font-size: 58px;

    line-height: 1.08;

    letter-spacing: -2px;

    margin-bottom: 25px;
}

.gradient-text {
    background: linear-gradient(
        90deg,
        #4f46e5,
        #9333ea
    );

    -webkit-background-clip: text;

    -webkit-text-fill-color: transparent;
}

.hero-description {
    font-size: 18px;

    color: #64748b;

    max-width: 600px;

    margin-bottom: 35px;
}

.hero-buttons {
    display: flex;

    gap: 15px;
}

.primary-button {
    padding: 14px 25px;

    border: none;

    border-radius: 9px;

    background: #4f46e5;

    color: white;

    font-size: 15px;

    font-weight: 600;

    text-decoration: none;

    cursor: pointer;

    transition: 0.3s;
}

.primary-button:hover {
    background: #4338ca;

    transform: translateY(-2px);

    box-shadow: 0 10px 25px rgba(79,70,229,0.25);
}

.secondary-button {
    padding: 14px 25px;

    border: 1px solid #cbd5e1;

    border-radius: 9px;

    background: white;

    color: #334155;

    font-weight: 600;

    text-decoration: none;

    transition: 0.3s;
}

.secondary-button:hover {
    border-color: #4f46e5;

    color: #4f46e5;
}

/* =====================================================
   UPLOAD CARD
===================================================== */

.upload-wrapper {
    position: relative;
}

.upload-card {
    background: rgba(255,255,255,0.92);

    backdrop-filter: blur(20px);

    border: 1px solid rgba(255,255,255,0.8);

    border-radius: 24px;

    padding: 35px;

    box-shadow:
        0 25px 70px rgba(79,70,229,0.15);

    text-align: center;
}

.upload-icon {
    width: 75px;

    height: 75px;

    margin: auto;

    display: flex;

    align-items: center;

    justify-content: center;

    border-radius: 20px;

    background: #eef2ff;

    font-size: 35px;

    margin-bottom: 20px;
}

.upload-card h3 {
    font-size: 22px;

    margin-bottom: 8px;
}

.upload-card p {
    color: #64748b;

    font-size: 14px;

    margin-bottom: 25px;
}

.drop-zone {
    border: 2px dashed #c7d2fe;

    border-radius: 15px;

    padding: 30px 20px;

    transition: 0.3s;
}

.drop-zone.dragover {
    background: #eef2ff;

    border-color: #4f46e5;
}

.file-input {
    display: none;
}

.browse-button {
    display: inline-block;

    padding: 12px 22px;

    background: #4f46e5;

    color: white;

    border-radius: 8px;

    cursor: pointer;

    font-weight: 600;
}

.file-name {
    margin-top: 15px;

    color: #475569;

    font-size: 13px;
}

/* =====================================================
   STATISTICS
===================================================== */

.stats {
    background: white;

    border-bottom: 1px solid #e5e7eb;
}

.stats-container {
    max-width: 1100px;

    margin: auto;

    padding: 45px 20px;

    display: grid;

    grid-template-columns:
        repeat(4,1fr);

    gap: 20px;

    text-align: center;
}

.stat h2 {
    font-size: 32px;

    color: #4f46e5;
}

.stat p {
    color: #64748b;

    font-size: 14px;
}

/* =====================================================
   FEATURES
===================================================== */

.section {
    padding: 100px 20px;
}

.section-header {
    max-width: 700px;

    margin: auto;

    text-align: center;

    margin-bottom: 55px;
}

.section-header .small-title {
    color: #4f46e5;

    font-size: 13px;

    font-weight: 700;

    text-transform: uppercase;

    letter-spacing: 1px;
}

.section-header h2 {
    font-size: 40px;

    margin: 10px 0;
}

.section-header p {
    color: #64748b;
}

.features-grid {
    max-width: 1100px;

    margin: auto;

    display: grid;

    grid-template-columns:
        repeat(3,1fr);

    gap: 25px;
}

.feature-card {
    background: white;

    padding: 32px;

    border-radius: 18px;

    border: 1px solid #e5e7eb;

    transition: 0.3s;
}

.feature-card:hover {
    transform: translateY(-7px);

    box-shadow:
        0 20px 40px rgba(15,23,42,0.08);
}

.feature-icon {
    width: 55px;

    height: 55px;

    display: flex;

    align-items: center;

    justify-content: center;

    border-radius: 14px;

    background: #eef2ff;

    font-size: 26px;

    margin-bottom: 20px;
}

.feature-card h3 {
    margin-bottom: 10px;
}

.feature-card p {
    color: #64748b;

    font-size: 14px;
}

/* =====================================================
   HOW IT WORKS
===================================================== */

.how-section {
    background: #111827;

    color: white;

    padding: 100px 20px;
}

.how-container {
    max-width: 1100px;

    margin: auto;
}

.how-header {
    text-align: center;

    margin-bottom: 55px;
}

.how-header h2 {
    font-size: 40px;
}

.how-header p {
    color: #94a3b8;
}

.steps {
    display: grid;

    grid-template-columns:
        repeat(3,1fr);

    gap: 30px;
}

.step {
    text-align: center;
}

.step-number {
    width: 60px;

    height: 60px;

    display: flex;

    align-items: center;

    justify-content: center;

    margin: auto;

    border-radius: 50%;

    background: #4f46e5;

    font-size: 20px;

    font-weight: bold;

    margin-bottom: 20px;
}

.step p {
    color: #94a3b8;

    font-size: 14px;
}

/* =====================================================
   DASHBOARD
===================================================== */

.dashboard {
    max-width: 1100px;

    margin: auto;

    background: white;

    border: 1px solid #e5e7eb;

    border-radius: 22px;

    padding: 35px;

    box-shadow:
        0 20px 50px rgba(0,0,0,0.05);
}

.dashboard-grid {
    display: grid;

    grid-template-columns:
        0.8fr 1.2fr;

    gap: 25px;
}

.score-card,
.skills-card {
    border: 1px solid #e5e7eb;

    border-radius: 15px;

    padding: 30px;
}

.score-card {
    text-align: center;
}

.score-circle {
    width: 170px;

    height: 170px;

    margin: 25px auto;

    border-radius: 50%;

    background:
        conic-gradient(
            #4f46e5 84%,
            #e5e7eb 84%
        );

    display: flex;

    align-items: center;

    justify-content: center;
}

.score-inner {
    width: 135px;

    height: 135px;

    border-radius: 50%;

    background: white;

    display: flex;

    align-items: center;

    justify-content: center;

    flex-direction: column;
}

.score-number {
    font-size: 38px;

    font-weight: 800;
}

.score-label {
    color: #64748b;

    font-size: 12px;
}

.skills-list {
    display: flex;

    flex-wrap: wrap;

    gap: 10px;

    margin-top: 20px;
}

.skill {
    padding: 8px 13px;

    background: #eef2ff;

    color: #4338ca;

    border-radius: 20px;

    font-size: 13px;
}

/* =====================================================
   JOB RECOMMENDATIONS
===================================================== */

.jobs {
    margin-top: 35px;
}

.job-card {
    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 20px;

    padding: 22px;

    border: 1px solid #e5e7eb;

    border-radius: 14px;

    margin-bottom: 12px;

    transition: 0.3s;
}

.job-card:hover {
    border-color: #a5b4fc;

    box-shadow:
        0 10px 25px rgba(79,70,229,0.08);
}

.job-info h3 {
    margin-bottom: 5px;
}

.job-info p {
    color: #64748b;

    font-size: 13px;
}

.match {
    background: #dcfce7;

    color: #166534;

    padding: 7px 12px;

    border-radius: 20px;

    font-size: 12px;

    font-weight: 700;

    white-space: nowrap;
}

/* =====================================================
   CTA
===================================================== */

.cta {
    padding: 90px 20px;

    text-align: center;

    background:
        linear-gradient(
            135deg,
            #4f46e5,
            #7c3aed
        );

    color: white;
}

.cta h2 {
    font-size: 40px;

    margin-bottom: 15px;
}

.cta p {
    color: #ddd6fe;

    margin-bottom: 30px;
}

.cta-button {
    display: inline-block;

    background: white;

    color: #4f46e5;

    padding: 14px 28px;

    border-radius: 8px;

    text-decoration: none;

    font-weight: 700;
}

/* =====================================================
   FOOTER
===================================================== */

footer {
    background: #0f172a;

    color: white;

    padding: 60px 20px 25px;
}

.footer-container {
    max-width: 1100px;

    margin: auto;

    display: grid;

    grid-template-columns:
        2fr 1fr 1fr;

    gap: 50px;
}

.footer-column h3 {
    margin-bottom: 15px;
}

.footer-column p,
.footer-column a {
    color: #94a3b8;

    font-size: 14px;

    text-decoration: none;

    display: block;

    margin-bottom: 8px;
}

.footer-bottom {
    max-width: 1100px;

    margin: 40px auto 0;

    padding-top: 20px;

    border-top: 1px solid #1e293b;

    text-align: center;

    color: #64748b;

    font-size: 13px;
}

/* =====================================================
   RESPONSIVE
===================================================== */

@media(max-width: 900px) {

    .hero-container {
        grid-template-columns: 1fr;

        text-align: center;
    }

    .hero-content {
        margin: auto;
    }

    .hero-buttons {
        justify-content: center;
    }

    .stats-container {
        grid-template-columns:
            repeat(2,1fr);
    }

    .features-grid,
    .steps {
        grid-template-columns: 1fr;
    }

    .dashboard-grid {
        grid-template-columns: 1fr;
    }

    .footer-container {
        grid-template-columns: 1fr;
    }
}

@media(max-width: 600px) {

    .nav-links {
        display: none;
    }

    .hero h1 {
        font-size: 40px;
    }

    .stats-container {
        grid-template-columns: 1fr;
    }

    .hero-buttons {
        flex-direction: column;
    }

}